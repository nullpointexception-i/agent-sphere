<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <property name="LOG_PATH" value="${LOG_PATH:-./logs}" />
    <property name="LOG_FILE" value="${LOG_FILE:-agent-sphere}" />

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>100MB</maxFileSize>
            <maxHistory>7</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%X{traceId:-}] %-5level %thread --- [%logger{40}] : %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%X{traceId:-}] %-5level %thread --- [%logger{40}] : %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>

    <logger name="com.buukle" level="DEBUG" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <logger name="com.buukle.agent.instance.repository" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <logger name="com.buukle.agent.model.repository" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <logger name="com.buukle.agent.capability" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- Skill auto-sync must show each round's result (whether it ran, how many were scanned, how many were synced).
         The parent logger com.buukle.agent.capability=WARN suppresses its only log.info,
         yet that is the only evidence of whether the task had any effect.
         Only SkillSyncRunner is raised (not the whole impl package — it also contains CapabilitySkillServiceImpl
         business logs, and turning all of it to INFO would just be noise). The parent logger has additivity="false",
         so an appender-ref must be declared here or the logs never reach disk. -->
    <logger name="com.buukle.agent.capability.skill.service.impl.SkillSyncRunner" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <!-- The three background paths of wait suspend-resume (in-memory timer / cron compensation / timeout reconciliation)
         have no request thread logging on site, and a failed wake silently wedges the run (claim already set the record
         to RESUMED, so listDue no longer picks it up).
         The whole wait package is pinned to INFO here so that raising com.buukle to WARN later does not suppress the
         only diagnostic trail. When the parent logger explicitly sets additivity="false", an appender-ref must be
         declared here or the logs never reach disk. -->
    <logger name="com.buukle.agent.runtime.orchestration.wait" level="INFO" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>

    <logger name="org.apache.catalina.connector.CoyoteAdapter" level="WARN" additivity="false">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </logger>
</configuration>
