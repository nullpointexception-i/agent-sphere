erDiagram
    agent_user ||--o{ agent_sso_identity : "agent_user_id"
    agent_identity_provider ||--o{ agent_sso_identity : "code = provider_code"
    agent_identity_provider }o--o| sys_role : "default_role_id"
    agent_user ||--o{ sys_user_role : "user_id"
    sys_role ||--o{ sys_user_role : "role_id"
    sys_role ||--o{ sys_role_permission : "role_id"
    sys_permission ||--o{ sys_role_permission : "permission_id"
    capability_skill ||--o{ capability_skill_sync_run : "1:N（逻辑）"

    agent_user {
        bigserial id PK "主键"
        varchar username "登录名"
        varchar password "密码哈希"
        varchar display_name "显示名"
        varchar english_name "英文名"
        varchar email "邮箱"
        text avatar "头像"
        varchar super_admin "是否超级管理员"
        varchar token "当前登录令牌"
        timestamp last_login_at "最后登录时间"
        varchar last_login_ip "最后登录IP"
        varchar last_login_ua "最后登录UA"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_identity_provider {
        bigserial id PK "主键"
        varchar code "身份源编码"
        varchar type "类型 OIDC"
        varchar name "名称"
        varchar issuer "Issuer"
        varchar client_id "客户端ID"
        varchar client_secret "客户端密钥"
        varchar authorization_endpoint "授权端点"
        varchar token_endpoint "令牌端点"
        varchar jwks_url "公钥地址"
        varchar scopes "授权范围"
        jsonb claim_mappings "Claim映射"
        bigint default_role_id FK "默认角色ID"
        jsonb resource_template "开户资源模板"
        boolean enabled "是否启用"
        varchar status "状态"
        varchar remark "备注"
        boolean delete_flag "逻辑删除"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_sso_identity {
        bigserial id PK "主键"
        varchar provider_code "身份源编码"
        varchar subject "外部用户唯一标识"
        varchar display_subject "展示用标识"
        bigint agent_user_id FK "本地用户ID"
        varchar status "状态"
        varchar remark "备注"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    sys_role {
        bigserial id PK "主键"
        varchar name "角色名"
        varchar code "角色编码"
        varchar description "描述"
        varchar status "状态"
        varchar remark "备注"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    sys_permission {
        bigserial id PK "主键"
        varchar name "权限名"
        varchar code "权限编码"
        varchar type "类型"
        bigint parent_id "父权限ID"
        integer sort "排序"
        varchar description "描述"
        varchar status "状态"
        varchar remark "备注"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    sys_role_permission {
        bigserial id PK "主键"
        bigint role_id FK "角色ID"
        bigint permission_id FK "权限ID"
        varchar status "状态"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    sys_user_role {
        bigserial id PK "主键"
        bigint user_id FK "用户ID"
        bigint role_id FK "角色ID"
        varchar status "状态"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    capability_skill {
        bigserial id PK "主键"
        varchar name "技能名"
        text description "描述"
        jsonb definition "技能定义(promptTemplate)"
        varchar visibility "可见性 PRIVATE/PUBLIC"
        integer version "版本号"
        bigint origin_skill_id "来源技能ID(fork)"
        integer origin_version "来源版本"
        integer install_count "安装次数"
        boolean auto_update "是否自动同步"
        timestamp synced_at "最近同步时间"
        integer synced_from_version "同步时来源版本"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    capability_skill_sync_run {
        bigserial id PK "主键"
        varchar trigger_type "触发方式 CRON/MANUAL"
        varchar status "状态"
        integer scanned_count "扫描数"
        integer handled "处理数"
        integer updated "更新数"
        integer skipped "跳过数"
        integer batch_size "批大小"
        jsonb detail "逐条明细"
        varchar skip_reason "跳过原因"
        text error_message "错误信息"
        bigint elapsed_ms "耗时(ms)"
        timestamp started_at "开始时间"
        timestamp finished_at "结束时间"
        varchar remark "备注"
        smallint delete_flag "逻辑删除"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    capability_mcp {
        bigserial id PK "主键"
        varchar name "名称"
        text description "描述"
        varchar server_url "服务地址"
        varchar server_type "传输类型"
        jsonb auth_config "鉴权配置"
        jsonb tool_definitions "工具定义"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    capability_cli {
        bigserial id PK "主键"
        varchar name "名称"
        varchar command_template "命令模板"
        jsonb param_schema "参数Schema"
        varchar working_dir "工作目录"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }
