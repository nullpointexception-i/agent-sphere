erDiagram
    agent_instance ||--o{ agent_session : "1:N"
    agent_instance ||--o{ agent_instance_capability : "1:N"
    agent_session ||--o{ agent_run : "1:N (physical FK)"
    agent_session ||--o{ agent_timeline : "1:N"
    agent_session ||--o{ agent_session_todo : "1:N"
    agent_session ||--o{ agent_pending_clarification : "1:N"
    agent_session ||--o{ agent_memory : "1:N"
    agent_session ||--o{ agent_compact_record : "1:N"
    agent_run ||--o{ agent_timeline : "ref_run_id"
    agent_run ||--o{ agent_tool_call_record : "1:N"
    agent_run ||--o{ agent_llm_interaction_record : "1:N"
    agent_run ||--o{ agent_sub_agent_run : "1:N"
    agent_run ||--o{ agent_pending_wait : "1:N"
    agent_run ||--o{ agent_user_in_loop_record : "1:N"

    agent_instance {
        bigserial id PK "primary key"
        varchar name "instance name"
        text description "description"
        text system_prompt "system prompt"
        text image "avatar URL"
        bigint model_route_id FK "default model route"
        jsonb custom_instructions "custom instructions"
        varchar business_type "business domain (task matching)"
        integer max_loop_count "loop cap (null = global)"
        jsonb config "extra config"
        boolean allow_console_session "allow console sessions"
        boolean allow_widget_session "allow widget sessions"
        varchar status "status ENABLED/DISABLED"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_instance_capability {
        bigserial id PK "primary key"
        bigint instance_id FK "instance id"
        varchar capability_type "type MCP/SKILL/CLI/BUILTIN"
        bigint capability_id "capability id (polymorphic, no FK)"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_session {
        bigserial id PK "primary key"
        varchar title "session title"
        bigint agent_instance_id FK "instance id"
        jsonb context_data "context snapshot"
        boolean cached_in_redis "cached in Redis"
        text summary "compacted history summary"
        timestamp summary_updated_at "summary updated at"
        bigint summary_model_route_id "model route used for summary"
        boolean title_auto_generated "title auto generated"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by (row-level key)"
        varchar updated_by "updated by"
        timestamp created_at "created at (cleanup criterion)"
        timestamp updated_at "updated at (cleanup criterion)"
    }

    agent_run {
        bigserial id PK "primary key"
        bigint session_id FK "session id"
        varchar type "run type"
        text user_message "user message"
        text assistant_reply "final assistant reply"
        text intent_classification "intent classification"
        bigint task_id "owning task id"
        varchar status "PENDING/RUNNING/WAITING/AWAITING_USER/COMPLETED/FAILED/CANCELLED"
        text reasoning "reasoning text"
        smallint loop_capped "1 = stopped by loop cap"
        text attachments "attachments"
        integer loop_count "turns used (accumulated across suspends)"
        integer loop_limit "pinned turn limit"
        text error_message "failure reason"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_timeline {
        bigserial id PK "primary key"
        bigint session_id FK "session id"
        bigint run_id "owning run"
        bigint seq "per-session sequence (SSE cursor)"
        varchar kind "row kind user/assistant/tool/clarification/subagent/run_status/error"
        varchar subtype "subtype"
        varchar state "execution state RUNNING/DONE/FAILED"
        bigint group_id "event group id"
        varchar title "display label snapshot"
        bigint ref_run_id "referenced run"
        bigint ref_interaction_id "referenced LLM interaction"
        bigint ref_tool_call_id "referenced tool call"
        bigint ref_sub_agent_run_id "referenced sub agent"
        bigint ref_clarification_id "referenced clarification"
        varchar status "status"
        varchar remark "remark"
        smallint delete_flag "logical delete"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_tool_call_record {
        bigserial id PK "primary key"
        bigint step_id "step number"
        bigint run_id FK "owning run"
        bigint session_id "session id"
        varchar tool_name "tool name"
        varchar display_name "display name (zh)"
        varchar display_name_en "display name (en)"
        text arguments_json "arguments JSON"
        text compressed_arguments "compressed arguments"
        text artifact "tool result"
        text compressed_artifact "compressed result"
        varchar call_id "provider call id"
        bigint sub_agent_run_id "owning sub agent"
        varchar status "status PENDING/RUNNING/DONE/FAILED"
        text error_message "error message"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_llm_interaction_record {
        bigserial id PK "primary key"
        bigint run_id FK "owning run"
        bigint session_id "session id"
        bigint sub_agent_run_id "owning sub agent"
        varchar interaction_type "interaction type"
        varchar model_name "model name"
        text request_body "raw request"
        text response_body "raw response"
        text reasoning "reasoning text"
        text reply_content "reply content"
        integer http_status "HTTP status"
        integer duration_ms "duration (ms)"
        text error_message "error message"
        boolean success "succeeded"
        jsonb usage "token usage"
        integer prompt_tokens "prompt tokens"
        integer completion_tokens "completion tokens"
        integer total_tokens "total tokens"
        integer cache_hit_tokens "cache hit tokens"
        integer cache_miss_tokens "cache miss tokens"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_sub_agent_run {
        bigserial id PK "primary key"
        bigint session_id "session id"
        bigint run_id FK "owning run"
        bigint parent_run_id "parent run"
        varchar parent_tool_call_id "parent tool call id"
        varchar agent_type "sub agent type"
        varchar agent_ref "sub agent reference"
        varchar display_name "display name"
        varchar status "status"
        timestamp started_at "started at"
        timestamp finished_at "finished at"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_pending_wait {
        bigserial id PK "primary key"
        bigint session_id "session id"
        bigint run_id FK "owning run"
        varchar call_id "tool call id"
        integer wait_ms "wait duration (ms)"
        timestamp wake_at "wake-up time"
        varchar status "status PENDING/RESUMED/CANCELLED"
        varchar reason "wait reason"
        timestamp resumed_at "resumed at"
        integer attempts "resume attempts"
        varchar last_error "last error"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_pending_clarification {
        bigserial id PK "primary key"
        bigint session_id FK "session id"
        bigint run_id "owning run"
        bigint message_id "message id"
        varchar clarification_id "short clarification id"
        varchar title "title"
        varchar type "clarification type"
        text options "options JSON"
        text user_response "user response"
        timestamp expires_at "expires at"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_session_todo {
        bigserial id PK "primary key"
        bigint session_id FK "session id"
        bigint run_id "owning run"
        varchar content "todo content"
        varchar status "status"
        varchar priority "priority"
        integer sort_order "sort order"
        bigint skill_id "source skill id"
        varchar step_id "source step id"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_memory {
        bigserial id PK "primary key"
        bigint session_id FK "session id"
        bigint run_id "source run"
        bigint task_id "source task"
        varchar type "memory type"
        text summary "summary"
        jsonb content "memory content"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_compact_record {
        bigserial id PK "primary key"
        bigint session_id FK "session id"
        bigint compacted_upto_run_id "compacted up to run"
        text summary_before "summary before"
        text summary_after "summary after"
        bigint token_count "token count after"
        varchar status "status"
        text error_message "error message"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_user_in_loop_record {
        bigserial id PK "primary key"
        bigint step_id "step number"
        bigint run_id FK "owning run"
        bigint session_id "session id"
        varchar interaction_type "interaction type"
        varchar status "status"
        text prompt "question asked"
        text response "user response"
        varchar responded_by "responded by"
        varchar result "outcome"
        text comment "comment"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }
