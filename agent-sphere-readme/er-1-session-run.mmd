erDiagram
    agent_instance ||--o{ agent_session : "1:N"
    agent_instance ||--o{ agent_instance_capability : "1:N"
    agent_session ||--o{ agent_run : "1:N（物理FK）"
    agent_session ||--o{ agent_timeline : "1:N"
    agent_session ||--o{ agent_session_todo : "1:N"
    agent_session ||--o{ agent_pending_clarification : "1:N"
    agent_session ||--o{ agent_memory : "1:N"
    agent_session ||--o{ agent_compact_record : "1:N"
    agent_run ||--o{ agent_timeline : "ref_run_id"
    agent_run ||--o{ agent_tool_call_record : "1:N"
    agent_run ||--o{ agent_llm_interaction_record : "1:N"
    agent_run ||--o{ agent_sub_agent_run : "1:N"
    agent_run ||--o{ agent_pending_wait : "1:N"
    agent_run ||--o{ agent_user_in_loop_record : "1:N"

    agent_instance {
        bigserial id PK "主键"
        varchar name "实例名称"
        text description "实例描述"
        text system_prompt "系统提示词"
        text image "头像地址"
        bigint model_route_id FK "默认模型路由ID"
        jsonb custom_instructions "自定义指令"
        varchar business_type "业务域标识(外部任务匹配)"
        integer max_loop_count "轮次上限(空=用全局)"
        jsonb config "扩展配置"
        boolean allow_console_session "允许主站建会话"
        boolean allow_widget_session "允许Widget建会话"
        varchar status "状态 ENABLED/DISABLED"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_instance_capability {
        bigserial id PK "主键"
        bigint instance_id FK "实例ID"
        varchar capability_type "能力类型 MCP/SKILL/CLI/BUILTIN"
        bigint capability_id "能力ID(多态,无FK)"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_session {
        bigserial id PK "主键"
        varchar title "会话标题"
        bigint agent_instance_id FK "实例ID"
        jsonb context_data "上下文快照"
        boolean cached_in_redis "是否已缓存Redis"
        text summary "历史压缩摘要"
        timestamp summary_updated_at "摘要更新时间"
        bigint summary_model_route_id "摘要所用模型路由"
        boolean title_auto_generated "标题是否自动生成"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人(行级权限键)"
        varchar updated_by "更新人"
        timestamp created_at "创建时间(清理判据)"
        timestamp updated_at "更新时间(清理判据)"
    }

    agent_run {
        bigserial id PK "主键"
        bigint session_id FK "会话ID"
        varchar type "运行类型"
        text user_message "用户消息"
        text assistant_reply "助手最终回复"
        text intent_classification "意图分类"
        bigint task_id "所属任务ID"
        varchar status "状态 PENDING/RUNNING/WAITING/AWAITING_USER/COMPLETED/FAILED/CANCELLED"
        text reasoning "推理内容"
        smallint loop_capped "是否被loop cap强收口"
        text attachments "附件列表"
        integer loop_count "已用轮次(跨挂起累加)"
        integer loop_limit "固化轮次上限"
        text error_message "失败原因"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_timeline {
        bigserial id PK "主键"
        bigint session_id FK "会话ID"
        bigint run_id "所属run"
        bigint seq "会话内递增序号(SSE游标)"
        varchar kind "行类型 user/assistant/tool/clarification/subagent/run_status/error"
        varchar subtype "子类型"
        varchar state "执行状态 RUNNING/DONE/FAILED"
        bigint group_id "同组事件ID"
        varchar title "展示快照标签"
        bigint ref_run_id "关联run"
        bigint ref_interaction_id "关联LLM交互"
        bigint ref_tool_call_id "关联工具调用"
        bigint ref_sub_agent_run_id "关联子Agent"
        bigint ref_clarification_id "关联澄清"
        varchar status "状态"
        varchar remark "备注"
        smallint delete_flag "逻辑删除"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_tool_call_record {
        bigserial id PK "主键"
        bigint step_id "步骤序号"
        bigint run_id FK "所属run"
        bigint session_id "会话ID"
        varchar tool_name "工具名"
        varchar display_name "展示名(中文)"
        varchar display_name_en "展示名(英文)"
        text arguments_json "入参JSON"
        text compressed_arguments "压缩后入参"
        text artifact "工具结果"
        text compressed_artifact "压缩后结果"
        varchar call_id "模型侧调用ID"
        bigint sub_agent_run_id "所属子Agent"
        varchar status "状态 PENDING/RUNNING/DONE/FAILED"
        text error_message "错误信息"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_llm_interaction_record {
        bigserial id PK "主键"
        bigint run_id FK "所属run"
        bigint session_id "会话ID"
        bigint sub_agent_run_id "所属子Agent"
        varchar interaction_type "交互类型"
        varchar model_name "模型名"
        text request_body "原始请求体"
        text response_body "原始响应体"
        text reasoning "推理内容"
        text reply_content "回复正文"
        integer http_status "HTTP状态码"
        integer duration_ms "耗时(ms)"
        text error_message "错误信息"
        boolean success "是否成功"
        jsonb usage "token用量"
        integer prompt_tokens "输入token"
        integer completion_tokens "输出token"
        integer total_tokens "总token"
        integer cache_hit_tokens "缓存命中token"
        integer cache_miss_tokens "缓存未命中token"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_sub_agent_run {
        bigserial id PK "主键"
        bigint session_id "会话ID"
        bigint run_id FK "所属run"
        bigint parent_run_id "父run"
        varchar parent_tool_call_id "父工具调用ID"
        varchar agent_type "子Agent类型"
        varchar agent_ref "子Agent引用"
        varchar display_name "展示名"
        varchar status "状态"
        timestamp started_at "开始时间"
        timestamp finished_at "结束时间"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_pending_wait {
        bigserial id PK "主键"
        bigint session_id "会话ID"
        bigint run_id FK "所属run"
        varchar call_id "工具调用ID"
        integer wait_ms "等待时长(ms)"
        timestamp wake_at "唤醒时间点"
        varchar status "状态 PENDING/RESUMED/CANCELLED"
        varchar reason "等待原因"
        timestamp resumed_at "恢复时间"
        integer attempts "恢复尝试次数"
        varchar last_error "最近一次错误"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_pending_clarification {
        bigserial id PK "主键"
        bigint session_id FK "会话ID"
        bigint run_id "所属run"
        bigint message_id "消息ID"
        varchar clarification_id "澄清短ID"
        varchar title "标题"
        varchar type "澄清类型"
        text options "选项JSON"
        text user_response "用户回答"
        timestamp expires_at "过期时间"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_session_todo {
        bigserial id PK "主键"
        bigint session_id FK "会话ID"
        bigint run_id "所属run"
        varchar content "待办内容"
        varchar status "状态"
        varchar priority "优先级"
        integer sort_order "排序"
        bigint skill_id "来源技能ID"
        varchar step_id "来源步骤标识"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_memory {
        bigserial id PK "主键"
        bigint session_id FK "会话ID"
        bigint run_id "来源run"
        bigint task_id "来源任务"
        varchar type "记忆类型"
        text summary "摘要"
        jsonb content "记忆内容"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_compact_record {
        bigserial id PK "主键"
        bigint session_id FK "会话ID"
        bigint compacted_upto_run_id "压缩至哪个run"
        text summary_before "压缩前摘要"
        text summary_after "压缩后摘要"
        bigint token_count "压缩后token数"
        varchar status "状态"
        text error_message "错误信息"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_user_in_loop_record {
        bigserial id PK "主键"
        bigint step_id "步骤序号"
        bigint run_id FK "所属run"
        bigint session_id "会话ID"
        varchar interaction_type "交互类型"
        varchar status "状态"
        text prompt "提问内容"
        text response "用户回答"
        varchar responded_by "回答人"
        varchar result "结论"
        text comment "备注"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }
