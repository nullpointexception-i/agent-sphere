erDiagram
    agent_model_provider }o--o| agent_api_key : "api_key_id"
    agent_model_provider ||--o{ agent_model_route : "1:N"
    agent_model_route }o--o| agent_instance : "model_route_id"
    agent_instance ||--o{ agent_task : "1:N"
    agent_instance ||--o{ agent_completions : "business_type 匹配"
    agent_task ||--o{ agent_task_artifact : "1:N（物理FK）"
    agent_completions ||--o{ agent_completions_prompt : "1:N"
    agent_completions ||--o{ agent_completions_call : "1:N"
    agent_completions_prompt }o--o| agent_completions_call : "prompt_id"

    agent_instance {
        bigint id PK "实例ID(详见会话运行域)"
    }

    agent_model_provider {
        bigserial id PK "主键"
        varchar name "供应商名称"
        varchar base_url "接口基地址"
        bigint api_key_id FK "默认密钥ID"
        jsonb config "扩展配置"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_api_key {
        bigserial id PK "主键"
        bigint provider_id FK "供应商ID"
        varchar alias "别名"
        text key_value "密钥密文"
        varchar encrypted "是否加密"
        timestamp expires_at "过期时间"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_model_route {
        bigserial id PK "主键"
        bigint provider_id FK "供应商ID"
        varchar model_name "模型名"
        varchar company "厂商枚举 DEEPSEEK/OPENAI/QWEN/ZHIPU/ORCA"
        integer weight "权重"
        bigint max_input_tokens "最大输入token"
        bigint max_output_tokens "最大输出token"
        jsonb fallback_ids "备用路由ID"
        boolean supports_attachment "支持图片附件"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_task {
        bigserial id PK "主键"
        text goal "任务目标"
        jsonb context_json "上下文"
        jsonb expected_output_json "期望输出JSON Schema"
        jsonb config "任务配置"
        bigint instance_id FK "实例ID"
        bigint session_id "会话ID"
        bigint run_id "当前run"
        varchar status "状态 QUEUED/RUNNING/COMPLETED/FAILED/CANCELLED"
        jsonb result_json "最终结果"
        varchar callback_url "结果回调地址"
        varchar poll_phase "阶段 execute/extract/refine"
        timestamp polled_at "最后轮询时间"
        timestamp started_at "开始时间"
        integer task_timeout_seconds "业务方指定超时(秒)"
        varchar remark "备注(失败原因摘要)"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_task_artifact {
        bigserial id PK "主键"
        bigint task_id FK "任务ID"
        varchar artifact_type "产物阶段 execute/extract/refine"
        text content "产物内容"
        text schema_ref "Schema引用"
        bigint run_id "产出run"
        varchar status "状态"
        varchar remark "备注"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_completions {
        bigserial id PK "主键"
        varchar name "配置名称"
        text description "描述"
        bigint model_route_id "模型路由ID"
        bigint active_prompt_id "生效提示词版本ID"
        jsonb input_schema "输入Schema"
        jsonb output_schema "输出Schema"
        jsonb config "调用配置"
        varchar business_type "业务域(调用方匹配)"
        varchar remark "备注"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_completions_prompt {
        bigserial id PK "主键"
        bigint completions_id FK "所属补全配置"
        integer version "版本号"
        text prompt_system "系统提示词"
        text prompt_user "用户提示词模板"
        varchar remark "备注"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }

    agent_completions_call {
        bigserial id PK "主键"
        bigint completions_id FK "所属补全配置"
        bigint prompt_id "使用的提示词版本"
        jsonb input "调用入参"
        text output "模型输出"
        varchar model "实际模型名"
        jsonb usage "token用量"
        numeric cost "费用"
        varchar caller "调用方标识"
        varchar remark "备注"
        varchar status "状态"
        smallint delete_flag "逻辑删除"
        bigint tenant_id "租户ID"
        varchar created_by "创建人"
        varchar updated_by "更新人"
        timestamp created_at "创建时间"
        timestamp updated_at "更新时间"
    }
