erDiagram
    agent_user ||--o{ agent_sso_identity : "agent_user_id"
    agent_identity_provider ||--o{ agent_sso_identity : "code = provider_code"
    agent_identity_provider }o--o| sys_role : "default_role_id"
    agent_user ||--o{ sys_user_role : "user_id"
    sys_role ||--o{ sys_user_role : "role_id"
    sys_role ||--o{ sys_role_permission : "role_id"
    sys_permission ||--o{ sys_role_permission : "permission_id"
    capability_skill ||--o{ capability_skill_sync_run : "1:N (logical)"

    agent_user {
        bigserial id PK "primary key"
        varchar username "login name"
        varchar password "password hash"
        varchar display_name "display name"
        varchar english_name "english name"
        varchar email "email"
        text avatar "avatar"
        varchar super_admin "super admin flag"
        varchar token "current login token"
        timestamp last_login_at "last login at"
        varchar last_login_ip "last login IP"
        varchar last_login_ua "last login user agent"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_identity_provider {
        bigserial id PK "primary key"
        varchar code "provider code"
        varchar type "type OIDC"
        varchar name "name"
        varchar issuer "issuer"
        varchar client_id "client id"
        varchar client_secret "client secret"
        varchar authorization_endpoint "authorization endpoint"
        varchar token_endpoint "token endpoint"
        varchar jwks_url "JWKS URL"
        varchar scopes "scopes"
        jsonb claim_mappings "claim mappings"
        bigint default_role_id FK "default role id"
        jsonb resource_template "provisioning resource template"
        boolean enabled "enabled"
        varchar status "status"
        varchar remark "remark"
        boolean delete_flag "logical delete"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_sso_identity {
        bigserial id PK "primary key"
        varchar provider_code "provider code"
        varchar subject "external user id"
        varchar display_subject "display subject"
        bigint agent_user_id FK "local user id"
        varchar status "status"
        varchar remark "remark"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    sys_role {
        bigserial id PK "primary key"
        varchar name "role name"
        varchar code "role code"
        varchar description "description"
        varchar status "status"
        varchar remark "remark"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    sys_permission {
        bigserial id PK "primary key"
        varchar name "permission name"
        varchar code "permission code"
        varchar type "type"
        bigint parent_id "parent permission id"
        integer sort "sort order"
        varchar description "description"
        varchar status "status"
        varchar remark "remark"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    sys_role_permission {
        bigserial id PK "primary key"
        bigint role_id FK "role id"
        bigint permission_id FK "permission id"
        varchar status "status"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    sys_user_role {
        bigserial id PK "primary key"
        bigint user_id FK "user id"
        bigint role_id FK "role id"
        varchar status "status"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    capability_skill {
        bigserial id PK "primary key"
        varchar name "skill name"
        text description "description"
        jsonb definition "skill definition (promptTemplate)"
        varchar visibility "visibility PRIVATE/PUBLIC"
        integer version "version"
        bigint origin_skill_id "origin skill id (fork)"
        integer origin_version "origin version"
        integer install_count "install count"
        boolean auto_update "auto update"
        timestamp synced_at "last synced at"
        integer synced_from_version "synced from version"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    capability_skill_sync_run {
        bigserial id PK "primary key"
        varchar trigger_type "trigger CRON/MANUAL"
        varchar status "status"
        integer scanned_count "scanned"
        integer handled "handled"
        integer updated "updated"
        integer skipped "skipped"
        integer batch_size "batch size"
        jsonb detail "per-item detail"
        varchar skip_reason "skip reason"
        text error_message "error message"
        bigint elapsed_ms "elapsed (ms)"
        timestamp started_at "started at"
        timestamp finished_at "finished at"
        varchar remark "remark"
        smallint delete_flag "logical delete"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    capability_mcp {
        bigserial id PK "primary key"
        varchar name "name"
        text description "description"
        varchar server_url "server URL"
        varchar server_type "transport type"
        jsonb auth_config "auth config"
        jsonb tool_definitions "tool definitions"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    capability_cli {
        bigserial id PK "primary key"
        varchar name "name"
        varchar command_template "command template"
        jsonb param_schema "parameter schema"
        varchar working_dir "working directory"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }
