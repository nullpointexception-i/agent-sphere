erDiagram
    agent_model_provider }o--o| agent_api_key : "api_key_id"
    agent_model_provider ||--o{ agent_model_route : "1:N"
    agent_model_route }o--o| agent_instance : "model_route_id"
    agent_instance ||--o{ agent_task : "1:N"
    agent_instance ||--o{ agent_completions : "business_type match"
    agent_task ||--o{ agent_task_artifact : "1:N (physical FK)"
    agent_completions ||--o{ agent_completions_prompt : "1:N"
    agent_completions ||--o{ agent_completions_call : "1:N"
    agent_completions_prompt }o--o| agent_completions_call : "prompt_id"

    agent_instance {
        bigint id PK "instance id (full fields in 4.3.1)"
    }

    agent_model_provider {
        bigserial id PK "primary key"
        varchar name "provider name"
        varchar base_url "API base URL"
        bigint api_key_id FK "default API key id"
        jsonb config "extra config"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_api_key {
        bigserial id PK "primary key"
        bigint provider_id FK "provider id"
        varchar alias "alias"
        text key_value "encrypted key"
        varchar encrypted "encrypted flag"
        timestamp expires_at "expires at"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_model_route {
        bigserial id PK "primary key"
        bigint provider_id FK "provider id"
        varchar model_name "model name"
        varchar company "vendor DEEPSEEK/OPENAI/QWEN/ZHIPU/ORCA"
        integer weight "weight"
        bigint max_input_tokens "max input tokens"
        bigint max_output_tokens "max output tokens"
        jsonb fallback_ids "fallback route ids"
        boolean supports_attachment "supports image attachments"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_task {
        bigserial id PK "primary key"
        text goal "task goal"
        jsonb context_json "context"
        jsonb expected_output_json "expected output JSON Schema"
        jsonb config "task config"
        bigint instance_id FK "instance id"
        bigint session_id "session id"
        bigint run_id "current run"
        varchar status "QUEUED/RUNNING/COMPLETED/FAILED/CANCELLED"
        jsonb result_json "final result"
        varchar callback_url "callback URL"
        varchar poll_phase "phase execute/extract/refine"
        timestamp polled_at "last polled at"
        timestamp started_at "started at"
        integer task_timeout_seconds "caller-specified timeout (s)"
        varchar remark "remark (failure summary)"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_task_artifact {
        bigserial id PK "primary key"
        bigint task_id FK "task id"
        varchar artifact_type "phase execute/extract/refine"
        text content "artifact content"
        text schema_ref "schema reference"
        bigint run_id "producing run"
        varchar status "status"
        varchar remark "remark"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_completions {
        bigserial id PK "primary key"
        varchar name "config name"
        text description "description"
        bigint model_route_id "model route id"
        bigint active_prompt_id "active prompt version id"
        jsonb input_schema "input schema"
        jsonb output_schema "output schema"
        jsonb config "call config"
        varchar business_type "business domain (caller match)"
        varchar remark "remark"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_completions_prompt {
        bigserial id PK "primary key"
        bigint completions_id FK "owning completions config"
        integer version "version number"
        text prompt_system "system prompt"
        text prompt_user "user prompt template"
        varchar remark "remark"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }

    agent_completions_call {
        bigserial id PK "primary key"
        bigint completions_id FK "owning completions config"
        bigint prompt_id "prompt version used"
        jsonb input "call input"
        text output "model output"
        varchar model "actual model name"
        jsonb usage "token usage"
        numeric cost "cost"
        varchar caller "caller identifier"
        varchar remark "remark"
        varchar status "status"
        smallint delete_flag "logical delete"
        bigint tenant_id "tenant id"
        varchar created_by "created by"
        varchar updated_by "updated by"
        timestamp created_at "created at"
        timestamp updated_at "updated at"
    }
